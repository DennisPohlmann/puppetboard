# Settings of docker-compose/proxy: copy to .env next to docker-compose.yml
# (required). A line that stays commented out keeps the default;
# ../standalone/.env.example lists the other Puppetboard settings.
# Put real secrets only into .env (git-ignored), never into this file.

# Long random string: openssl rand -hex 32
SECRET_KEY=

# Existing PuppetDB, client certificate in ./ssl/ (see ../standalone/README.md)
PUPPETDB_HOST=puppetdb.example.com
PUPPETDB_PORT=8081
PUPPETDB_SSL_VERIFY=/etc/puppetboard/ssl/ca.pem
PUPPETDB_KEY=/etc/puppetboard/ssl/key.pem
PUPPETDB_CERT=/etc/puppetboard/ssl/cert.pem

OFFLINE_MODE=true

# JSON API and MCP server; MCP_ALLOWED_HOSTS is the host name the clients use.
ENABLE_API=true
ENABLE_MCP=true
MCP_ALLOWED_HOSTS=puppetboard.example.com

# Published HTTPS port of nginx. Default: 443.
#HTTPS_PORT=443
