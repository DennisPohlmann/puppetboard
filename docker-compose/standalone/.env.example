# Settings of docker-compose/standalone: copy to .env next to
# docker-compose.yml (required) and change what you need. A line that stays
# commented out keeps the default. The README of the repository explains each setting
# ("App settings"), docs/API.md the API_* ones and docs/MCP.md the MCP_* ones.
# Put real secrets only into .env (git-ignored), never into this file.

# --- Required
# Long random string, the same for every replica: openssl rand -hex 32
SECRET_KEY=

# --- PuppetDB
PUPPETDB_HOST=puppetdb.example.com
PUPPETDB_PORT=8081
# Path to the CA to check PuppetDB's certificate, or true/false.
PUPPETDB_SSL_VERIFY=/etc/puppetboard/ssl/ca.pem
# Client certificate signed by the Puppet CA (paths, or the PEM text itself).
PUPPETDB_KEY=/etc/puppetboard/ssl/key.pem
PUPPETDB_CERT=/etc/puppetboard/ssl/cert.pem
# http or https; empty: https when a key and certificate are set.
#PUPPETDB_PROTO=
# Seconds per PuppetDB request. Default: 20.
PUPPETDB_TIMEOUT=20

# --- Web interface
# Environment shown first, * for all. Default: production.
DEFAULT_ENVIRONMENT=production
PAGE_TITLE=Puppetboard
# Serve all JavaScript and CSS locally instead of from cdnjs. Default: false.
OFFLINE_MODE=true
# Hours without a report after which a node counts as unreported. Default: 2.
UNRESPONSIVE_HOURS=2
# Query page and the API/MCP PQL query. Default: true.
ENABLE_QUERY=true
# Catalog pages (needs certificate access to catalogs). Default: false.
ENABLE_CATALOG=false
# Classes page. Default: false.
ENABLE_CLASS=false
# Seconds until the overview reloads itself; 0 = never. Default: 30.
REFRESH_RATE=30
# Run below a path, e.g. /puppetboard. Default: /.
#PUPPETBOARD_URL_PREFIX=
LOGLEVEL=info

# --- JSON API and MCP server (no authentication of their own: put the
# reverse proxy with authentication in front, see ../proxy/)
ENABLE_API=false
ENABLE_MCP=false
# Host name(s) the MCP clients use, comma-separated, e.g. puppetboard.example.com
#MCP_ALLOWED_HOSTS=puppetboard.example.com
#MCP_ALLOWED_ORIGINS=
# Requests per minute and client, 0 = off. Default: 120.
API_RATE_LIMIT=120
# API reference on /api/v1/docs (with ENABLE_API). Default: true.
#API_DOCS=true

# --- Container
# Listen port inside the container. Default: 8080.
PUPPETBOARD_PORT=8080
# Gunicorn workers. Default: 1.
PUPPETBOARD_WORKERS=2
